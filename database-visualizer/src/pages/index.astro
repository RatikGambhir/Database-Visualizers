---
import DownloadButtons from '@/components/download-buttons';
import SiteHeader from '@/components/SiteHeader.astro';
import ProductWindow from '@/components/ProductWindow.astro';
import AppSpec from '@/components/AppSpec.astro';
import SourcesTable from '@/components/SourcesTable.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import { apps } from '@/data/apps';
import '@/styles/global.css';
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#13110e" />
    <meta name="description" content="Database Visualizer — native macOS visualizers for SQLite, PostgreSQL, MySQL and HelixDB. Your data has a shape. Now you can see it." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Database Visualizer</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />

    <main id="main">
      <section class="hero container" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="kicker reveal" style="--i:0">Desktop apps for macOS</p>
          <h1 id="hero-title" class="reveal" style="--i:1"><span>Your data has a shape.</span> <span>Now you can see it.</span></h1>
          <p class="hero-lede reveal" style="--i:2">Native macOS visualizers for SQLite, PostgreSQL, MySQL and HelixDB. Map schemas, trace relationships, and stop squinting at <code>SELECT *</code>.</p>
          <div id="download" class="hero-actions reveal" style="--i:3">
            <DownloadButtons />
            <a class="text-link" href="#apps">Compare the two apps <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-visual reveal" style="--i:2">
          <ProductWindow />
        </div>
      </section>

      <section id="apps" class="apps container" aria-labelledby="apps-title">
        <div class="section-intro">
          <p class="kicker">The apps</p>
          <h2 id="apps-title">Two shapes of data. An app for each.</h2>
          <p>Relational schemas and graphs deserve different pictures. Pick the app that matches how your data is stored.</p>
        </div>
        <div class="apps-grid">
          {apps.map((app) => <AppSpec app={app} />)}
        </div>
      </section>

      <section id="sources" class="sources container" aria-labelledby="sources-title">
        <div class="section-intro">
          <p class="kicker">Compatibility</p>
          <h2 id="sources-title">What connects to what</h2>
          <p>SQL dumps in other dialects still open as static schema diagrams. Tablescape shows up to 500 rows per query result.</p>
        </div>
        <SourcesTable />
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<style>
  /* Hero: copy and the live product view, side by side from laptop widths up. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
    padding-block: clamp(3rem, 2rem + 5vw, 6.5rem) var(--section-gap);
  }
  .hero-copy { display: grid; gap: var(--space-5); align-content: center; max-width: 40rem; }
  h1 {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  h1 span { display: block; text-wrap: balance; }
  h1 span:last-child { color: var(--fg-subtle); }
  .hero-lede { max-width: 33rem; margin: 0; color: var(--fg-muted); font-size: var(--text-lg); line-height: 1.55; text-wrap: pretty; }
  .hero-lede code { color: var(--fg); font-family: var(--font-code); font-size: 0.9em; }
  .hero-actions { display: grid; gap: var(--space-4); justify-items: start; margin-top: var(--space-3); }

  .text-link {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
    transition: color var(--dur-fast) var(--ease-out), text-decoration-color var(--dur-fast) var(--ease-out);
  }
  .text-link:hover { color: var(--fg); text-decoration-color: var(--amber); }

  @media (min-width: 1080px) {
    .hero { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--space-8); align-items: center; }
  }

  /* Section intros share one pattern; the content beneath each one changes shape. */
  .section-intro { display: grid; gap: var(--space-3); max-width: 38rem; margin-bottom: var(--space-7); }
  h2 { margin: 0; font-size: var(--text-2xl); font-weight: 600; line-height: 1.1; letter-spacing: -0.03em; text-wrap: balance; }
  .section-intro p:last-child { margin: 0; color: var(--fg-muted); font-size: var(--text-lg); line-height: 1.55; }

  .apps { padding-block: var(--section-gap); border-top: 1px solid var(--line); }
  .apps-grid { display: grid; gap: var(--space-8); }
  @media (min-width: 880px) {
    /* Subgrid keeps both apps' summaries, feature lists and actions on shared rows. */
    .apps-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto auto; gap: var(--space-6) 0; }
    .apps-grid > :global(.spec) { display: grid; grid-row: span 3; grid-template-rows: subgrid; }
    .apps-grid > :global(.spec:first-child) { padding-right: clamp(2rem, 4vw, 4.5rem); }
    .apps-grid > :global(.spec:last-child) { padding-left: clamp(2rem, 4vw, 4.5rem); border-left: 1px solid var(--line); }
  }
  @media (max-width: 879px) {
    .apps-grid > :global(.spec + .spec) { padding-top: var(--space-8); border-top: 1px solid var(--line); }
  }

  /* Sources: heading on the left, the matrix on the right. */
  .sources { padding-block: var(--section-gap); border-top: 1px solid var(--line); }
  @media (min-width: 1080px) {
    .sources { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: var(--space-8); align-items: start; }
    .sources .section-intro { margin-bottom: 0; position: sticky; top: var(--space-6); }
  }

  /* One coordinated entrance for the first viewport. */
  .reveal { animation: reveal var(--dur-slow) var(--ease-out) both; animation-delay: calc(var(--i) * 80ms); }
  @keyframes reveal { from { opacity: 0; transform: translateY(10px); } }
</style>
