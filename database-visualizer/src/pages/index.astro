---
import DownloadButtons from '@/components/download-buttons';
import '@/styles/global.css';
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content="Database Visualizer — native macOS visualizers for SQLite, PostgreSQL, MySQL and HelixDB. Your data has a shape. Now you can see it." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Database Visualizer</title>
  </head>
  <body>
    <main class="hero" aria-labelledby="hero-title">
      <div class="atmosphere" aria-hidden="true"></div>
      <div class="horizon" aria-hidden="true"></div>
      <section class="hero-content">
        <h1 id="hero-title"><span>Your data has a shape.</span><span>Now you can see it.</span></h1>
        <p class="hero-description">Native macOS visualizers for SQLite, PostgreSQL, MySQL and HelixDB.<br class="desktop-break" /> Map schemas, trace relationships, and stop squinting at SELECT *.</p>
        <DownloadButtons />
      </section>
    </main>
  </body>
</html>
