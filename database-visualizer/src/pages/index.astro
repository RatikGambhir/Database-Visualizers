---
import DownloadButtons from '@/components/download-buttons';
import '@/styles/global.css';
---
<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#090909" />
    <meta name="description" content="Database Visualizer — give your big idea the design it deserves." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Database Visualizer</title>
  </head>
  <body>
    <main class="hero" aria-labelledby="hero-title">
      <div class="atmosphere" aria-hidden="true"></div>
      <div class="horizon" aria-hidden="true"></div>
      <section class="hero-content">
        <h1 id="hero-title"><span>Give your big idea the</span><span>design it deserves</span></h1>
        <p class="hero-description">Professionally designed blocks and templates built with React,<br class="desktop-break" /> Shadcn/ui and Tailwind that will help your product stand out.</p>
        <DownloadButtons />
      </section>
    </main>
  </body>
</html>
