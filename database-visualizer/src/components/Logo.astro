---
// Two tables joined by a foreign key: the same idea as the Tablescape icon, drawn as a line mark.
---
<a class="logo" href="/" aria-label="Database Visualizer home">
  <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
    <rect x="2.75" y="3.75" width="10.5" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M2.75 7.25h10.5" stroke="var(--amber)" stroke-width="1.5" />
    <rect x="10.75" y="12.25" width="10.5" height="8" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M10.75 15.75h10.5" stroke="var(--amber)" stroke-width="1.5" />
    <path d="M13.25 9.5h2.5a1.5 1.5 0 0 1 1.5 1.5v1.25" fill="none" stroke="var(--steel)" stroke-width="1.5" stroke-linecap="round" />
  </svg>
  <span>Database Visualizer</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--fg);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .logo svg { flex: none; }
</style>
