+//! Regression tests for the optional atlas-mutation-v1 extension.
+use super::*;
+use crate::{HelixDbSource, HelixStorage};
+use serde_json::{json, Value};
+
+async fn execute(service: &HelixQueryService, request: Value) -> Value {
+    let request =
+        simd_json::from_reader::<_, QueryRequest>(request.to_string().as_bytes()).unwrap();
+    let response = service.execute_query(request).await.unwrap();
+    serde_json::from_slice(&response.to_json_bytes().unwrap()).unwrap()
+}
+
+#[tokio::test]
+async fn atlas_mutation_high_ids_create_project_and_read_back_exactly() {
+    let db = Arc::new(
+        HelixDB::open(HelixDbSource::InMemory {
+            database: "atlas-high-ids".into(),
+        })
+        .await
+        .unwrap(),
+    );
+    let HelixStorage::Writer(writer) = db.storage() else {
+        panic!("writer")
+    };
+    let first = (i64::MAX as u64) + 100;
+    writer.node_ids().reserve_at_least(first).await.unwrap();
+    writer
+        .edge_ids()
+        .reserve_at_least(first + 10)
+        .await
+        .unwrap();
+    let service = HelixQueryService::new(db);
+    let request = json!({"request_type":"write","query":{"write":{"entries":[
+        {"query":{"name":"a","root":{"add_n":{"label":"High","properties":[]}}}},
+        {"query":{"name":"b","root":{"add_n":{"label":"High","properties":[]}}}},
+        {"query":{"name":"check","condition":{"require_single_node":"a"},"root":{"inject":{"variable":"a"}}}},
+        {"query":{"name":"e","root":{"add_e":{"input":{"inject":{"variable":"a"}},"label":"HighEdge","to":{"var":"b"},"properties":[]}}}},
+        {"query":{"name":"aid","root":{"id":{"input":{"inject":{"variable":"a"}}}}}},
+        {"query":{"name":"bid","root":{"id":{"input":{"inject":{"variable":"b"}}}}}},
+        {"query":{"name":"eid","root":{"id":{"input":{"inject":{"variable":"e"}}}}}},
+        {"query":{"name":"source","root":{"id":{"input":{"in_n":{"input":{"inject":{"variable":"e"}}}}}}}},
+        {"query":{"name":"target","root":{"id":{"input":{"out_n":{"input":{"inject":{"variable":"e"}}}}}}}}
+    ],"returns":["aid","bid","eid","source","target"]}}});
+    let response = execute(&service, request.clone()).await;
+    assert_eq!(response["aid"][0], first);
+    assert_eq!(response["bid"][0], first + 1);
+    assert_eq!(response["eid"][0], first + 10);
+    assert_eq!(response["source"][0], first);
+    assert_eq!(response["target"][0], first + 1);
+    let read = json!({"request_type":"read","query":{"read":{"entries":[{"query":{"name":"ids","root":{"id":{"input":{"nodes":{"reference":{"ids":[first, first+1]}}}}}}}],"returns":["ids"]}}});
+    let read_response = execute(&service, read.clone()).await;
+    assert_eq!(read_response["ids"], json!([first, first + 1]));
+    if let Ok(path) = std::env::var("ATLAS_HIGH_ID_CAPTURE") {
+        std::fs::write(path, serde_json::to_string_pretty(&json!({"request":request,"response":response,"readRequest":read,"readResponse":read_response})).unwrap()).unwrap();
+    }
+}
+
+#[tokio::test]
+async fn atlas_mutation_endpoint_deletion_races_do_not_leave_dangling_edges() {
+    let db = Arc::new(
+        HelixDB::open(HelixDbSource::InMemory {
+            database: "atlas-endpoint-race".into(),
+        })
+        .await
+        .unwrap(),
+    );
+    let service = HelixQueryService::new(db);
+    for round in 0..32 {
+        let seed = execute(
+            &service,
+            json!({"request_type":"write","query":{"write":{"entries":[
+            {"query":{"name":"a","root":{"add_n":{"label":"Race","properties":[]}}}},
+            {"query":{"name":"b","root":{"add_n":{"label":"Race","properties":[]}}}}
+        ],"returns":["a","b"]}}}),
+        )
+        .await;
+        let a = seed["a"][0]["$id"].as_u64().unwrap();
+        let b = seed["b"][0]["$id"].as_u64().unwrap();
+        let insert = json!({"request_type":"write","query":{"write":{"entries":[
+            {"query":{"name":"a","root":{"nodes":{"reference":{"ids":[a]}}}}},
+            {"query":{"name":"check","condition":{"require_single_node":"a"},"root":{"inject":{"variable":"a"}}}},
+            {"query":{"name":"e","root":{"add_e":{"input":{"inject":{"variable":"a"}},"label":"RaceEdge","to":{"ids":[b]},"properties":[]}}}}
+        ],"returns":[]}}});
+        let deleted_endpoint = if round % 2 == 0 { a } else { b };
+        let delete = json!({"request_type":"write","query":{"write":{"entries":[{"query":{"name":"drop","root":{"drop":{"input":{"nodes":{"reference":{"ids":[deleted_endpoint]}}}}}}}],"returns":[]}}});
+        let (insert_result, delete_result) = tokio::join!(
+            service.execute_query(
+                simd_json::from_reader::<_, QueryRequest>(insert.to_string().as_bytes()).unwrap()
+            ),
+            service.execute_query(
+                simd_json::from_reader::<_, QueryRequest>(delete.to_string().as_bytes()).unwrap()
+            ),
+        );
+        assert!(insert_result.is_ok() || delete_result.is_ok());
+        let counts = execute(&service, json!({"request_type":"read","query":{"read":{"entries":[
+            {"query":{"name":"edges","root":{"count":{"input":{"edges":{"reference":"all"}}}}}},
+            {"query":{"name":"sources","root":{"count":{"input":{"in_n":{"input":{"edges":{"reference":"all"}}}}}}}},
+            {"query":{"name":"targets","root":{"count":{"input":{"out_n":{"input":{"edges":{"reference":"all"}}}}}}}}
+        ],"returns":["edges","sources","targets"]}}})).await;
+        assert_eq!(counts["edges"], counts["sources"]);
+        assert_eq!(counts["edges"], counts["targets"]);
+    }
+}
